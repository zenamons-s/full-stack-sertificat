{
  "name": "gift-certificates/backend",
  "type": "project",
  "require": {
    "php": "^8.3",
    "doctrine/dbal": "^4.2",
    "doctrine/migrations": "^3.8",
    "firebase/php-jwt": "^7.0",
    "monolog/monolog": "^3.8",
    "php-di/php-di": "^7.0",
    "predis/predis": "^2.3",
    "ramsey/uuid": "^4.7",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "symfony/console": "^7.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "App\\Migrations\\": "migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3.33"
    },
    "sort-packages": true
  }
}
