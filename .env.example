# Значения ниже предназначены для локального запуска и подлежат замене в любой реальной среде.

# --- db ---
POSTGRES_DB=certificates
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
DATABASE_URL=pgsql://app:change_me@postgres:5432/certificates

# --- backend ---
APP_ENV=production
JWT_SECRET=change_me_local_jwt_secret_32_chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
REDIS_URL=redis://redis:6379
CACHE_TTL=60 # TTL кеша списков сертификатов в секундах
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=Password123!

# --- worker ---
WORKER_INTERVAL=60s # Интервал запуска цикла истечения сертификатов
WORKER_BATCH_SIZE=500
WORKER_ADVISORY_LOCK_ID=982451653 # ID advisory lock для единственного активного воркера
SYNC_MODE=db # Режим синхронизации истечения: db или api
API_BASE_URL=http://nginx/api/v1
WORKER_API_EMAIL=worker@example.com
WORKER_API_PASSWORD=WorkerPass123!
LOG_LEVEL=info

# --- frontend ---
API_INTERNAL_URL=http://nginx/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
